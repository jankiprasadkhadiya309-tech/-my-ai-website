{
  "name": "beyond-ai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BEYOND AI backend: AI editing planner (Anthropic API), FFmpeg video processing, storage. Zero npm dependencies.",
  "main": "server.js",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node test/e2e.mjs && node test/premium.mjs",
    "test:deno": "deno test --allow-run=node --allow-env --allow-read --allow-write --allow-net test/deno.test.ts",
    "test:all": "npm test && npm run test:deno"
  }
}
